rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    match /activities/{docId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAuth();
    }

    match /announcements/{docId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAuth();
    }

    match /kuliah/{docId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAuth();
    }

    match /jadualKuliah/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /kategoriKuliah/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /quotes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /donations/{docId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;           // public can submit donations
      allow update, delete: if isAuth();
    }

    match /anakKariah/{docId} {
      allow create: if true;           // public registration
      allow read, update, delete: if isAuth();
    }

    // Public read enabled for register page
    match /kawasan/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /adminUsers/{docId} {
      allow read, write: if isAuth();
    }

    match /notifications/{docId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if true;
      allow delete: if isAuth();
    }

    match /settings/{docId} {
      allow read: if true;             // public can read settings (e.g. derma page)
      allow write: if isAuth();
    }

    // Authenticated users' FCM tokens (multi-device support)
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
      allow delete: if (isAuth() && request.auth.uid == userId) || true;
    }

    // CollectionGroup query support for FCM tokens
    match /{path=**}/fcmTokens/{tokenId} {
      allow read: if isAuth();
    }

    // Guest/public FCM tokens — allows ANY device without login to register for notifications
    match /guestTokens/{tokenId} {
      allow create, update: if true
        && request.resource.data.token is string;
      allow read, delete: if false;    // Only Admin SDK (server) can read/delete
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}