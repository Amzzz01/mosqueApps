rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }

    match /activities/{docId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAuth();
    }

    match /announcements/{docId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAuth();
    }

    match /kuliah/{docId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAuth();
    }

    match /jadualKuliah/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /kategoriKuliah/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /quotes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /donations/{docId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAuth();
    }

    match /anakKariah/{docId} {
      allow read, write: if isAuth();
    }

    // ✅ UPDATED — public read for register page
    match /kawasan/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /adminUsers/{docId} {
      allow read, write: if isAuth();
    }

    match /notifications/{docId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if true;
      allow delete: if isAuth();
    }

    match /settings/{docId} {
      allow read, write: if isAuth();
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
      allow create, update: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.token is string
        && request.resource.data.createdAt is timestamp;
      allow delete: if (isAuth() && request.auth.uid == userId) || true;
    }
    
    match /{path=**}/fcmTokens/{tokenId} {
      allow read: if isAuth();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}