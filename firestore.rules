rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: authenticated user
    function isAuth() {
      return request.auth != null;
    }

    // Activities - Admin full read/write, Public limited read
    match /activities/{docId} {
      allow read: if isAuth();
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create, update, delete: if isAuth();
    }

    // Announcements - Admin full read/write, Public limited read
    match /announcements/{docId} {
      allow read: if isAuth();
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create, update, delete: if isAuth();
    }

    // Kuliah (lectures) - legacy, Public can read, Admin can write
    match /kuliah/{docId} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create, update, delete: if isAuth();
    }

    // Jadual Kuliah v2 - Public can read, Admin can write
    match /jadualKuliah/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    // Kategori Kuliah - Public can read, Admin can write
    match /kategoriKuliah/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    // Donations - Admin full read/write, Public limited read
    match /donations/{docId} {
      allow read: if isAuth();
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create, update, delete: if isAuth();
    }

    // Members (anakKariah) - Admin only
    match /anakKariah/{docId} {
      allow read, write: if isAuth();
    }

    // Kawasan (kariah areas) - Admin only
    match /kawasan/{docId} {
      allow read, write: if isAuth();
    }

    // Admin users - Admin only
    match /adminUsers/{docId} {
      allow read, write: if isAuth();
    }

    // Notifications - Admin read/write
    match /notifications/{docId} {
      allow read, write: if isAuth();
    }

    // Notification settings - Admin read/write
    match /settings/{docId} {
      allow read, write: if isAuth();
    }

    // FCM tokens - users can write their own tokens
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
      allow create, update: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.token is string
        && request.resource.data.createdAt is timestamp;
    }

    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
